<group name="local,custom,honeypot,ml">

  <!-- =================================================================== -->
  <!-- Group Honeypot Servers -->
  <!-- =================================================================== -->
  <rule id="100000" level="3">
    <if_sid>86601</if_sid>
    <hostname>Tpot</hostname>
    <description>Honeypot - $(alert.signature)</description>
  </rule>

  <!-- =================================================================== -->
  <!-- Group Honeypot Alerts - Honeypot Suricata Alerts -->
  <!-- =================================================================== -->
  <rule id="100014" level="11">
      <if_sid>100000</if_sid>
      <field name="alert.severity">3</field>
      <description>Honeypot Suricata Alert Severity 3 - $(alert.signature). Source IP: $(src_ip). Destination IP: $(dest_ip).</description>
  </rule>
  <rule id="100015" level="13">
      <if_sid>100000</if_sid>
      <field name="alert.severity">2</field>
      <description>Honeypot Suricata Alert Severity 2 - $(alert.signature). Source IP: $(src_ip). Destination IP: $(dest_ip).</description>
  </rule>
  <rule id="100016" level="15">
      <if_sid>100000</if_sid>
      <field name="alert.severity">1</field>
      <description>Honeypot Suricata Alert Severity 1 - $(alert.signature). Source IP: $(src_ip). Destination IP: $(dest_ip).</description>
  </rule>

  <!-- =================================================================== -->
  <!-- Cowrie Honeypot login attempts -->
  <!-- =================================================================== -->
  <rule id="100075" level="11">
    <decoded_as>json</decoded_as>
    <field name="eventid">cowrie.login.failed</field>
    <description>Honeypot Cowrie Session: $(session) . $(username) tried to login to honeypot from Source IP: $(src_ip).</description>
  </rule>
  <rule id="100076" level="13">
      <decoded_as>json</decoded_as>
      <field name="eventid">cowrie.command.input</field>
      <description>Honeypot Cowrie Session: $(session) Source IP: $(src_ip) executed command: $(input) result: $(message) </description>
  </rule>

  <!-- =================================================================== -->
  <!-- ML attacks detection logging -->
  <!-- =================================================================== -->
  <rule id="110101" level="12">
    <decoded_as>json</decoded_as>
    <field name="log_type">ml_attack_log</field>
    <field name="predicted_label">Brute Force</field>
    <description>Brute Force ML Detection - Source IP: $(srcip), Destination IP: $(dstip), Port: $(dstport)</description>
  </rule>
  <rule id="110102" level="14">
    <decoded_as>json</decoded_as>
    <field name="log_type">ml_attack_log</field>
    <field name="predicted_label">DDoS</field>
    <description>DDoS ML Detection - Source IP: $(srcip), Destination IP: $(dstip), Port: $(dstport)</description>
  </rule>
  <rule id="110103" level="13">
    <decoded_as>json</decoded_as>
    <field name="log_type">ml_attack_log</field>
    <field name="predicted_label">PortScan</field>
    <description>PortScan ML Detection - Source IP: $(srcip), Destination IP: $(dstip), Port: $(dstport)</description>
  </rule>
  <rule id="110104" level="15">
    <decoded_as>json</decoded_as>
    <field name="log_type">ml_attack_log</field>
    <field name="predicted_label">Web Attack</field>
    <description>Web Attack ML Detection - Source IP: $(srcip), Destination IP: $(dstip), Port: $(dstport)</description>
  </rule>
  <rule id="110105" level="14">
    <decoded_as>json</decoded_as>
    <field name="log_type">ml_attack_log</field>
    <field name="predicted_label">Bot</field>
    <description>Bot ML Detection - Source IP: $(srcip), Destination IP: $(dstip), Port: $(dstport)</description>
  </rule>
  <rule id="110106" level="16">
    <decoded_as>json</decoded_as>
    <field name="log_type">ml_attack_log</field>
    <field name="predicted_label">DoS</field>
    <description>DoS ML Detection - Source IP: $(srcip), Destination IP: $(dstip), Port: $(dstport)</description>
  </rule>


    <!-- =================================================================== -->
    <!-- Regole per log di Active Response custom -->
    <!-- =================================================================== -->
    <rule id="110100" level="8">
      <decoded_as>json</decoded_as>
      <field name="ar_script">^block_ip.py$</field>
      <field name="ar_command">^add$</field>
      <description>Active Response: Blocked source IP $(ip_address) for attacking $(destination_ip). Reason: Detected attack type '$(attack_type)' (Triggering rule: $(triggering_rule)).</description>
      <options>no_full_log</options>
    </rule>

    <!-- Regola per loggare lo sblocco automatico di un IP -->
    <rule id="100107" level="5">
      <decoded_as>json</decoded_as>
      <field name="ar_script">^block_ip.py$</field>
      <field name="ar_command">^delete$</field>
      <description>Active Response: Unblocked IP $(ip_address). Temporary block expired.</description>
      <options>no_full_log</options>
    </rule>

</group>